# ==========================================
# FineTube Frontend Environment Variables
# ==========================================

# Base URL for the FineTube Express Backend API.
# In local development: http://localhost:5000/api/v1
# In production: https://api.yourdomain.com/api/v1 (or /api/v1 if behind a reverse proxy/rewrite)
# If omitted or offline, FineTube UI automatically falls back to client-side store with 0 broken endpoints.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
