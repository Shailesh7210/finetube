{
  "name": "finetube-backend",
  "version": "1.0.0",
  "description": "FineTube Educational Video Platform - Modular Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx src/tests/blueprintQualityGates.test.ts",
    "test:simulation": "tsx src/tests/pilotEndToEndSimulation.test.ts",
    "test:backup": "tsx src/tests/disasterRecovery.test.ts",
    "test:all": "tsx src/tests/blueprintQualityGates.test.ts && tsx src/tests/pilotEndToEndSimulation.test.ts && tsx src/tests/disasterRecovery.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
