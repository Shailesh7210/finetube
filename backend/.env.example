# ==========================================
# FineTube Backend Environment Variables
# Copy this file to .env before deploying
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or self-hosted)
# If omitted or offline, FineTube automatically falls back to the in-memory seed store
MONGODB_URI=mongodb://127.0.0.1:27017/finetube

# Authentication Security (JWT Secret for session signatures)
JWT_SECRET=your-32-character-random-secure-jwt-secret-key-here

# CORS Configuration
# In production, set this to your frontend URL (e.g. https://finetube.vercel.app)
# Comma-separated list supported. Defaults to '*' if unset
CORS_ORIGIN=*

# Developer Sandbox Quota (Daily runs allowed per user)
DAILY_SANDBOX_QUOTA=50

# External AI & Video API Integrations (Optional)
# If omitted, FineTube uses internal deterministic grounded intelligence & YouTube IFrame API
YOUTUBE_API_KEY=
OPENAI_API_KEY=
